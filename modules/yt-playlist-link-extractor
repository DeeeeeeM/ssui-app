import gradio as gr
import yt_dlp
import csv
import io
import tempfile
import os
import threading

cancel_flag = threading.Event()


def extract_playlist(playlist_url: str, cookies_file: str | None, progress=gr.Progress()):
    cancel_flag.clear()

    if not playlist_url.strip():
        return None, "⚠️  Please enter a playlist URL.", ""

    progress(0, desc="Fetching playlist info…")

    ydl_opts = {
        "quiet": True,
        "no_warnings": True,
        "extract_flat": "in_playlist",   # fast — no downloading, just metadata
        "skip_download": True,
        "noplaylist": False,
        "http_headers": {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/124.0.0.0 Safari/537.36"
            ),
        },
    }
    if cookies_file:
        ydl_opts["cookiefile"] = cookies_file

    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(playlist_url.strip(), download=False)
    except Exception as e:
        return None, f"❌  Failed to fetch playlist: {e}", ""

    if not info:
        return None, "❌  No info returned. Check the URL.", ""

    entries = info.get("entries", [])
    if not entries:
        # single video URL passed — wrap it
        entries = [info]

    playlist_title = info.get("title", "playlist")

    rows = []
    log_lines = [f"📋  Playlist: {playlist_title}", f"🔢  {len(entries)} video(s) found\n"]

    for i, entry in enumerate(entries):
        if cancel_flag.is_set():
            log_lines.append("🛑  Cancelled.")
            break
        if not entry:
            continue

        progress((i + 1) / len(entries), desc=f"[{i+1}/{len(entries)}] collecting…")

        video_id = entry.get("id", "")
        url = entry.get("url") or entry.get("webpage_url") or (
            f"https://www.youtube.com/watch?v={video_id}" if video_id else ""
        )
        title = entry.get("title", "")
        uploader = entry.get("uploader") or entry.get("channel", "")
        duration = entry.get("duration")
        duration_str = ""
        if duration:
            m, s = divmod(int(duration), 60)
            h, m = divmod(m, 60)
            duration_str = f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"

        rows.append({
            "index": i + 1,
            "title": title,
            "url": url,
            "video_id": video_id,
            "uploader": uploader,
            "duration": duration_str,
        })
        log_lines.append(f"   [{i+1:>3}]  {title or url}")

    if not rows:
        return None, "⚠️  No entries extracted.", "\n".join(log_lines)

    # write CSV
    tmp_dir = tempfile.mkdtemp(prefix="pl_csv_")
    safe_name = "".join(c if c.isalnum() or c in " _-" else "_" for c in playlist_title)[:60]
    csv_path = os.path.join(tmp_dir, f"{safe_name}.csv")

    fieldnames = ["index", "title", "url", "video_id", "uploader", "duration"]
    with open(csv_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)

    summary = f"✅  {len(rows)} links saved to {safe_name}.csv"
    return csv_path, summary, "\n".join(log_lines)


def cancel():
    cancel_flag.set()
    return "🛑 Cancelling…"


